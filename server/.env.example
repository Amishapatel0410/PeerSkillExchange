# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/skillsync

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Meeting Links ─────────────────────────────────────────────────────────────
# Set to 'placeholder' for demo, 'google_meet' or 'zoom' for real integration
MEETING_PROVIDER=placeholder
# Google Meet (requires service account OAuth2 — see server/src/utils/meetingLink.js)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Zoom (requires Server-to-Server OAuth — see server/src/utils/meetingLink.js)
# ZOOM_API_KEY=
# ZOOM_API_SECRET=

# ── Email Reminders ───────────────────────────────────────────────────────────
# Leave blank to disable email reminders (in-app reminders always work)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=SkillSync <noreply@skillsync.demo>
